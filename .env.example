# Copy this file to .env (it is ignored by git). Everything is optional in
# development: without a .env the app runs with SQLite and dev settings.

# manage.py uses backlog_vault.settings.dev by default.
# DJANGO_SETTINGS_MODULE=backlog_vault.settings.dev

# --- production (backlog_vault.settings.prod) ---
# DJANGO_SETTINGS_MODULE=backlog_vault.settings.prod
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_DEMO_MODE=0

# POSTGRES_DB=backlog_vault
# POSTGRES_USER=backlog_vault
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_DB_PORT=5432
