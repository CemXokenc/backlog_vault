# Copy this file to .env (it is ignored by git). Everything is optional in
# development: without a .env the app runs with SQLite and dev settings.

# Switch the environment here: dev (default) or prod.
DJANGO_SETTINGS_MODULE=backlog_vault.settings.dev
# DJANGO_SETTINGS_MODULE=backlog_vault.settings.prod

# --- production (backlog_vault.settings.prod) ---
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=your-app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# DJANGO_DEMO_MODE=0

# POSTGRES_DB=backlog_vault
# POSTGRES_USER=backlog_vault
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_DB_PORT=5432

# Optional SMTP for activation e-mails (otherwise links go to the server log)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Backlog Vault <noreply@example.com>
